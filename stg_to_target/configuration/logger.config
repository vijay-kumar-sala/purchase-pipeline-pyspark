[loggers]
keys = root, appLogger, extractdataLogger

[handlers]
keys = fileHandler, consoleHandler

[formatters]
keys = simpleFormatter

[logger_root]
level = INFO
handlers = consoleHandler

[logger_appLogger]
level = INFO
handlers = fileHandler
qualname = applog

[logger_extractdataLogger]
level = INFO
handlers = fileHandler
qualname = extractdatalog

[handler_fileHandler]
class = FileHandler 
level = DEBUG
formatter = simpleFormatter
args = ('app.log','w',)

[handler_consoleHandler]
class = StreamHandler
level = DEBUG
formatter = simpleFormatter
args = (sys.stdout,)

[formatter_simpleFormatter]
format = "%(asctime)s - %(name)s - %(levelname)s - %(message)s"